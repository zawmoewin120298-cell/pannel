worker_processes 1;
events { worker_connections 1024; }

http {
    sendfile on;
    client_max_body_size 20m;

    server {
        listen ${PORT};
        server_name _; # Railway က ပို့တဲ့ Host ကို လက်ခံဖို့

        # VPN Traffic (VLESS over WebSocket)
        location ${VLESS_WS_PATH} {
            proxy_pass http://127.0.0.1:10000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 300s;
        }

        # ဟောင်းနွဲ့နေတဲ့ လမ်းကြောင်း
        location = /vless-ws {
            proxy_pass http://127.0.0.1:10000${VLESS_WS_PATH};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 300s;
        }

        # Panel (FastAPI)
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr; # ထပ်တိုးထားသည်
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
